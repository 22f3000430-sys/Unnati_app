<Window x:Class="SeatingApp.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Seating App"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="#0F172A">

            <DockPanel>

                <!-- APP TITLE -->

                <TextBlock Text="SEATING APP"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="20"
                           DockPanel.Dock="Top"/>

                <!-- MENU -->

                <StackPanel Margin="10">

                    <Button Content="Dashboard"
                            Height="45"
                            Margin="0,5"
                            Command="{Binding OpenDashboardCommand}"/>

                    <Button Content="Board Seating"
                             Margin="0,10,0,0"
                            Padding="10"
                            Command="{Binding OpenBoardSeatingCommand}"/>

                    <Button Content="Extraction"
                            Margin="0,10,0,0"
                            Padding="10"
                            Command="{Binding OpenOcrCommand}"/>

                    <Button Content="Reports"
                            Margin="0,10,0,0"
                            Padding="10"
                            Command="{Binding OpenReportsCommand}"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- MAIN CONTENT -->

        <Border Grid.Column="1"
                Background="#F1F5F9">

            <ContentControl Content="{Binding Navigation.CurrentView}"/>

        </Border>

    </Grid>

</Window>