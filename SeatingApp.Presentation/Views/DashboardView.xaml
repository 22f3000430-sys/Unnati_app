<UserControl x:Class="SeatingApp.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer>

        <StackPanel Margin="20">

            <TextBlock Text="Dashboard"
                       FontSize="30"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <UniformGrid Columns="3">

                <Border Margin="5"
                        Padding="20"
                        Background="#1E293B"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="Total Students"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding TotalStudents}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Margin="5"
                        Padding="20"
                        Background="#1E293B"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="Total Rooms"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding TotalRooms}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Margin="5"
                        Padding="20"
                        Background="#1E293B"
                        CornerRadius="10">

                    <StackPanel>
                        <TextBlock Text="Host Teachers"
                                   Foreground="White"/>

                        <TextBlock Text="{Binding HostTeachers}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

        </StackPanel>

    </ScrollViewer>

</UserControl>