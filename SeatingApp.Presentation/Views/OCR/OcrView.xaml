<UserControl
    x:Class="SeatingApp.Presentation.Views.OCR.OcrView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">

    <Grid Background="#F5F6FA">

        <!-- MAIN CONTENT -->

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP PANEL -->

            <Border
                Padding="15"

                Background="White"

                CornerRadius="8">

                <StackPanel>

                    <!-- TITLE -->

                    <TextBlock
                        FontSize="28"

                        FontWeight="Bold"

                        Foreground="#1E3A5F"

                        Text="Student OCR Extraction"/>

                    <TextBlock
                        Margin="0,5,0,15"

                        Foreground="Gray"

                        Text="Upload PDF and verify extracted student data before importing into database."/>

                    <!-- INPUT SECTION -->

                    <WrapPanel>

                        <!-- SCHOOL CODE -->

                        <StackPanel>

                            <TextBlock
                                Margin="0,0,0,5"

                                FontWeight="SemiBold"

                                Text="School Code"/>

                            <TextBox
                                Width="160"

                                Height="32"

                                Text="{Binding SchoolCode,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <!-- CLASS -->

                        <StackPanel
                            Margin="15,0,0,0">

                            <TextBlock
                                Margin="0,0,0,5"

                                FontWeight="SemiBold"

                                Text="Class"/>

                            <ComboBox
                                Width="120"
                                SelectedValue="{Binding ClassName}"
                                SelectedValuePath="Content">

                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="12"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- PDF -->

                        <StackPanel
                            Margin="15,0,0,0">

                            <TextBlock
                                Margin="0,0,0,5"

                                FontWeight="SemiBold"

                                Text="Selected PDF"/>

                            <TextBox
                                Width="400"

                                Height="32"

                                IsReadOnly="True"

                                Text="{Binding SelectedPdf}"/>

                        </StackPanel>

                    </WrapPanel>

                    <!-- BUTTONS -->

                    <StackPanel
                        Margin="0,20,0,0"

                        Orientation="Horizontal">

                        <Button
                            Width="140"

                            Height="36"

                            Content="Browse PDF"

                            Command="{Binding SelectPdfCommand}"/>

                        <Button
                            Width="140"

                            Height="36"

                            Margin="10,0,0,0"

                            Content="Extract OCR"

                            Command="{Binding ExtractCommand}"/>

                        <Button
                            Width="140"
                            Height="36"

                            Margin="10,0,0,0"

                            Content="Import to DB"

                            Command="{Binding ImportCommand}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- STATUS -->

            <Border
                Grid.Row="2"

                Padding="10"

                Background="White"

                CornerRadius="8">

                <TextBlock
                    FontSize="14"

                    FontWeight="SemiBold"

                    Foreground="#1E3A5F"

                    Text="{Binding Status}"/>

            </Border>

            <!-- OCR GRID -->

            <Border
                Grid.Row="4"

                Padding="10"

                Background="White"

                CornerRadius="8">

                <DataGrid
                    ItemsSource="{Binding Students}"

                    AutoGenerateColumns="False"

                    CanUserAddRows="True"

                    CanUserDeleteRows="True"

                    HeadersVisibility="Column"

                    GridLinesVisibility="All"

                    SelectionMode="Extended"

                    RowHeight="32">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Roll No"

                            Width="120"

                            Binding="{Binding RollNo,
                            UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="Form No"

                            Width="100"

                            Binding="{Binding FormNo,
                            UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="School Code"
                            Binding="{Binding SchoolCode}"/>

                        <DataGridTextColumn
                            Header="Class"
                            Binding="{Binding ClassName}"/>

                        <DataGridTextColumn
                            Header="Student Name"

                            Width="220"

                            Binding="{Binding StudentName,
                            UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="Mother Name"

                            Width="220"

                            Binding="{Binding MotherName,
                            UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="Father Name"

                            Width="220"

                            Binding="{Binding FatherName,
                            UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="Subjects"

                            Width="260"

                            Binding="{Binding Subjects,
                            UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGridTextColumn
                            Header="Registration No"

                            Width="200"

                            Binding="{Binding RegistrationNo,
                            UpdateSourceTrigger=PropertyChanged}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        <!-- LOADING OVERLAY -->

        <Grid
            Background="#80000000"

            Visibility="{Binding IsLoading,
            Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border
                Width="280"

                Height="140"

                Background="White"

                CornerRadius="10"

                HorizontalAlignment="Center"

                VerticalAlignment="Center">

                <StackPanel
                    VerticalAlignment="Center"

                    HorizontalAlignment="Center">

                    <ProgressBar
                        Width="200"

                        Height="20"

                        IsIndeterminate="True"/>

                    <TextBlock
                        Margin="0,20,0,0"

                        FontSize="16"

                        FontWeight="SemiBold"

                        HorizontalAlignment="Center"

                        Text="Processing OCR..."/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>