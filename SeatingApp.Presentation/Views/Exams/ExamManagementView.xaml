<Window
    x:Class="SeatingApp.Presentation.Views.Exams.ExamManagementView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:sys="clr-namespace:System;assembly=mscorlib"

    mc:Ignorable="d"

    Title="Exam Management"

    Height="600"

    Width="1100"

    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="15"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- TOP BAR -->

        <StackPanel
            Orientation="Horizontal">

            <Button
                Width="140"
                Height="38"

                FontSize="14"

                Content="Add Exam"

                Command="{Binding AddExamCommand}"/>

            <Button
                Width="140"
                Height="38"

                Margin="10,0,0,0"

                FontSize="14"

                Content="Save All"

                Command="{Binding SaveCommand}"/>

        </StackPanel>

        <!-- GRID -->

        <DataGrid
            Grid.Row="2"

            Margin="0,5,0,0"

            ItemsSource="{Binding Exams}"

            AutoGenerateColumns="False"

            CanUserAddRows="False"

            CanUserDeleteRows="False"

            SelectionUnit="Cell"

            SelectionMode="Extended"

            GridLinesVisibility="All"

            HeadersVisibility="Column"

            ColumnWidth="*"

            RowHeight="32"

            FontSize="14"

            PreviewKeyDown="DataGrid_PreviewKeyDown">

            <DataGrid.Columns>

                <!-- DATE -->

                <DataGridTemplateColumn
                    Header="Exam Date">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <DatePicker
                                SelectedDate="{Binding ExamDate,
                                UpdateSourceTrigger=PropertyChanged}"

                                DisplayDateStart="{x:Static sys:DateTime.Today}"/>
                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- SHIFT -->

                <DataGridTemplateColumn
                    Header="Shift">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <ComboBox
                                ItemsSource="{Binding DataContext.Shifts,
                                RelativeSource={RelativeSource AncestorType=Window}}"

                                SelectedItem="{Binding Shift,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- CLASS -->

                <DataGridTemplateColumn
                    Header="Class">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <ComboBox
                                ItemsSource="{Binding DataContext.Classes,
                                RelativeSource={RelativeSource AncestorType=Window}}"

                                SelectedItem="{Binding ClassName,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!-- SUBJECT -->

                <DataGridTemplateColumn
                    Header="Subject">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <ComboBox
                                ItemsSource="{Binding FilteredSubjects}"

                                DisplayMemberPath="Display"

                                SelectedValuePath="Code"

                                SelectedValue="{Binding SubjectCode,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <!-- SUMMARY -->

        <Border
            Grid.Row="3"

            Margin="0,10,0,0"

            Padding="12"

            BorderThickness="1"

            BorderBrush="#D0D0D0"

            Background="#F5F5F5">

            <StackPanel
                Orientation="Horizontal">

                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"

                    Text="Total Exams:"/>

                <TextBlock
                    Margin="10,0,0,0"

                    FontSize="15"

                    Text="{Binding TotalExams}"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>