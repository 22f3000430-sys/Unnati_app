<UserControl
    x:Class="SeatingApp.Presentation.Views.BoardSeating.BoardSeatingView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">

    <!-- =====================================================
         RESOURCES
    ====================================================== -->

    <UserControl.Resources>

        <SolidColorBrush x:Key="PageBg"
                         Color="#F8FAFC"/>

        <SolidColorBrush x:Key="PrimaryText"
                         Color="#0F172A"/>

        <SolidColorBrush x:Key="MutedText"
                         Color="#64748B"/>

        <!-- CARD -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="Padding"
                    Value="22"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <!-- BUTTON -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="border"

                            Background="{TemplateBinding Background}"

                            CornerRadius="14">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="border"

                                    Property="Background"

                                    Value="#1D4ED8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- =====================================================
         ROOT
    ====================================================== -->

    <Grid Background="{StaticResource PageBg}">

        <Grid Margin="28">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="24"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="28"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Text="Board Seating"

                    FontSize="34"

                    FontWeight="Bold"

                    Foreground="{StaticResource PrimaryText}"/>

                <TextBlock
                    Margin="0,6,0,0"

                    Text="Generate examination seating arrangements"

                    FontSize="14"

                    Foreground="{StaticResource MutedText}"/>

            </StackPanel>

            <!-- =====================================================
                 MAIN CONTENT
            ====================================================== -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="320"/>

                    <ColumnDefinition Width="24"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- =====================================================
                     LEFT PANEL
                ====================================================== -->

                <StackPanel Grid.Column="0">

                    <!-- MASTER SETUP -->

                    <Border
                        Style="{StaticResource CardStyle}"

                        Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock
                                Text="Master Setup"

                                FontSize="20"

                                FontWeight="SemiBold"

                                Foreground="{StaticResource PrimaryText}"

                                Margin="0,0,0,18"/>

                            <Button
                                Height="50"

                                Margin="0,0,0,12"

                                FontSize="14"

                                FontWeight="SemiBold"

                                Content="Manage Rooms"

                                Command="{Binding OpenRoomsCommand}"/>

                            <Button
                                Height="50"

                                FontSize="14"

                                FontWeight="SemiBold"

                                Content="Manage Exams"

                                Command="{Binding OpenExamsCommand}"/>

                        </StackPanel>

                    </Border>

                    <!-- RULES -->

                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="Seating Rules"

                                FontSize="20"

                                FontWeight="SemiBold"

                                Foreground="{StaticResource PrimaryText}"

                                Margin="0,0,0,18"/>

                            <CheckBox
                                Content="Mix Classes"

                                FontSize="14"

                                Margin="0,0,0,12"

                                IsChecked="{Binding MixClasses}"/>

                            <CheckBox
                                Content="Mix Genders"

                                FontSize="14"

                                IsChecked="{Binding MixGenders}"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- =====================================================
                     RIGHT PANEL
                ====================================================== -->

                <Border
                    Grid.Column="2"

                    Style="{StaticResource CardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="20"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <!-- TITLE -->

                        <StackPanel Grid.Row="0">

                            <TextBlock
                                Text="Select Examinations"

                                FontSize="22"

                                FontWeight="SemiBold"

                                Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock
                                Margin="0,6,0,0"

                                Text="Choose one or more exams for seating generation"

                                FontSize="13"

                                Foreground="{StaticResource MutedText}"/>

                        </StackPanel>

                        <!-- EXAM LIST -->

                        <ListBox
                            Grid.Row="2"

                            ItemsSource="{Binding Exams}"

                            BorderThickness="0"

                            Background="Transparent"

                            ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="0,0,0,14"

                                        Padding="18"

                                        Background="#F8FAFC"

                                        CornerRadius="14"

                                        BorderBrush="#E2E8F0"

                                        BorderThickness="1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="14"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <!-- CHECKBOX -->

                                            <CheckBox
                                                VerticalAlignment="Top"

                                                Margin="0,4,0,0"

                                                IsChecked="{Binding IsSelected}"/>

                                            <!-- DETAILS -->

                                            <Grid Grid.Column="2">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="120"/>

                                                </Grid.ColumnDefinitions>

                                                <!-- LEFT -->

                                                <StackPanel>

                                                    <TextBlock
                                                        Text="{Binding DisplayText}"

                                                        FontSize="15"

                                                        FontWeight="SemiBold"

                                                        Foreground="#0F172A"/>

                                                    <TextBlock
                                                        Margin="0,6,0,0"

                                                        Text="{Binding StudentsCount,
                                                        StringFormat='Students: {0}'}"

                                                        FontSize="12"

                                                        Foreground="#64748B"/>

                                                </StackPanel>

                                                <!-- SHIFT -->

                                                <Border
                                                    Grid.Column="1"

                                                    Width="100"

                                                    Height="30"

                                                    Background="#DBEAFE"

                                                    CornerRadius="15"

                                                    HorizontalAlignment="Right"

                                                    VerticalAlignment="Center">

                                                    <TextBlock
                                                        Text="{Binding Shift}"

                                                        FontSize="12"

                                                        FontWeight="SemiBold"

                                                        Foreground="#1D4ED8"

                                                        HorizontalAlignment="Center"

                                                        VerticalAlignment="Center"/>

                                                </Border>

                                            </Grid>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Border>

            </Grid>

            <!-- =====================================================
                 GENERATE BUTTON
            ====================================================== -->

            <Button
                Grid.Row="4"

                Width="300"

                HorizontalAlignment="Center"

                Style="{StaticResource PrimaryButtonStyle}"

                Content="Generate Seating Preview"

                Command="{Binding GenerateCommand}"/>

        </Grid>

        <!-- =====================================================
             LOADING
        ====================================================== -->

        <Grid
            Background="#70000000"

            Visibility="{Binding IsLoading,
            Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border
                Width="320"

                Height="150"

                Background="White"

                CornerRadius="18"

                HorizontalAlignment="Center"

                VerticalAlignment="Center">

                <StackPanel
                    HorizontalAlignment="Center"

                    VerticalAlignment="Center">

                    <ProgressBar
                        Width="220"

                        Height="6"

                        IsIndeterminate="True"/>

                    <TextBlock
                        Margin="0,20,0,0"

                        Text="Generating Seating Preview..."

                        FontSize="15"

                        FontWeight="SemiBold"

                        Foreground="#0F172A"

                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>