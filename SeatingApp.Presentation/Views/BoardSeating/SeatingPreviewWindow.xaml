<Window
    x:Class="SeatingApp.Presentation.Views.BoardSeating.SeatingPreviewWindow"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    Title="Seating Preview"

    Height="850"

    Width="1400"

    WindowStartupLocation="CenterOwner"

    Background="#F8FAFC">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="15"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="20"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="20"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- =====================================
             HEADER
        ====================================== -->

        <Border
            Grid.Row="0"

            Background="White"

            Padding="25"

            CornerRadius="0,0,18,18">

            <DockPanel>

                <StackPanel>

                    <TextBlock
                        Text="Seating Preview"

                        FontSize="32"

                        FontWeight="Bold"

                        Foreground="#0F172A"/>

                    <TextBlock
                        Margin="0,6,0,0"

                        Text="Review seating before saving reports"

                        FontSize="15"

                        Foreground="#64748B"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- =====================================
             SUMMARY CARDS
        ====================================== -->

        <UniformGrid
            Grid.Row="2"

            Columns="4"

            Margin="25,0">

            <!-- EXAMS -->

            <Border
                Background="White"

                CornerRadius="18"

                Padding="20"

                Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock
                        Text="Selected Exams"

                        FontSize="15"

                        Foreground="#64748B"/>

                    <TextBlock
                        Margin="0,10,0,0"

                        Text="{Binding TotalExams}"

                        FontSize="34"

                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- STUDENTS -->

            <Border
                Background="White"

                CornerRadius="18"

                Padding="20"

                Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock
                        Text="Students"

                        FontSize="15"

                        Foreground="#64748B"/>

                    <TextBlock
                        Margin="0,10,0,0"

                        Text="{Binding TotalStudents}"

                        FontSize="34"

                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- ROOMS -->

            <Border
                Background="White"

                CornerRadius="18"

                Padding="20"

                Margin="0,0,15,0">

                <StackPanel>

                    <TextBlock
                        Text="Rooms Used"

                        FontSize="15"

                        Foreground="#64748B"/>

                    <TextBlock
                        Margin="0,10,0,0"

                        Text="{Binding TotalRooms}"

                        FontSize="34"

                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- SEATS -->

            <Border
                Background="White"

                CornerRadius="18"

                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="Seats Allocated"

                        FontSize="15"

                        Foreground="#64748B"/>

                    <TextBlock
                        Margin="0,10,0,0"

                        Text="{Binding TotalSeats}"

                        FontSize="34"

                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- =====================================
             MAIN CONTENT
        ====================================== -->

        <Border
            Grid.Row="4"

            Margin="25"

            Background="White"

            CornerRadius="18"

            Padding="20">

            <TabControl>

                <!-- =====================================
                     SUMMARY TAB
                ====================================== -->

                <TabItem Header="Summary">

                    <DataGrid
                        Margin="10"

                        ItemsSource="{Binding Assignments}"

                        AutoGenerateColumns="False"

                        IsReadOnly="True"

                        CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Room"
                                Binding="{Binding RoomNo}"/>

                            <DataGridTextColumn
                                Header="Row"
                                Binding="{Binding RowNo}"/>

                            <DataGridTextColumn
                                Header="Column"
                                Binding="{Binding ColumnNo}"/>

                            <DataGridTextColumn
                                Header="Roll No"
                                Binding="{Binding RollNo}"/>

                            <DataGridTextColumn
                                Header="Student"
                                Binding="{Binding StudentName}"/>

                            <DataGridTextColumn
                                Header="Class"
                                Binding="{Binding ClassName}"/>

                            <DataGridTextColumn
                                Header="Gender"
                                Binding="{Binding Gender}"/>

                            <DataGridTextColumn
                                Header="School"
                                Binding="{Binding SchoolCode}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </TabItem>

                <!-- =====================================
                     ROOM TAB
                ====================================== -->

                <TabItem Header="Room Summary">

                    <Grid>

                        <TextBlock
                            Text="Room summary UI coming next..."

                            FontSize="20"

                            HorizontalAlignment="Center"

                            VerticalAlignment="Center"/>

                    </Grid>

                </TabItem>

                <!-- =====================================
                     MATRIX TAB
                ====================================== -->

                <TabItem Header="Seat Matrix">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"

                        HorizontalScrollBarVisibility="Auto">

                        <ItemsControl
                            ItemsSource="{Binding RoomGroups}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Margin="15"

                                        Padding="20"

                                        Background="White"

                                        BorderBrush="#CBD5E1"

                                        BorderThickness="1"

                                        CornerRadius="14">

                                        <StackPanel>

                                            <!-- ROOM HEADER -->

                                            <TextBlock
                                                Margin="0,0,0,15"

                                                FontSize="24"

                                                FontWeight="Bold"

                                                Foreground="#0F172A"

                                                Text="{Binding RoomNo,
                                                    StringFormat=Room {0}}"/>

                                            <!-- MATRIX -->

                                            <ItemsControl
                                                ItemsSource="{Binding Rows}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <StackPanel
                                                            Orientation="Horizontal">

                                                            <ItemsControl
                                                                ItemsSource="{Binding}">

                                                                <ItemsControl.ItemsPanel>

                                                                    <ItemsPanelTemplate>

                                                                        <UniformGrid
                                                                            Rows="1"/>

                                                                    </ItemsPanelTemplate>

                                                                </ItemsControl.ItemsPanel>

                                                                <ItemsControl.ItemTemplate>

                                                                    <DataTemplate>

                                                                        <Border
                                                                            Width="120"

                                                                            Height="90"

                                                                            Margin="2"

                                                                            BorderBrush="#1E293B"

                                                                            BorderThickness="1"

                                                                            Background="#F8FAFC">

                                                                            <StackPanel
                                                                                VerticalAlignment="Center"

                                                                                HorizontalAlignment="Center">

                                                                                <TextBlock
                                                                                    HorizontalAlignment="Center"

                                                                                    FontSize="15"

                                                                                    FontWeight="SemiBold"

                                                                                    Text="{Binding RollNo}"/>

                                                                                <TextBlock
                                                                                    Margin="0,6,0,0"

                                                                                    HorizontalAlignment="Center"

                                                                                    FontSize="13"

                                                                                    Foreground="#475569"

                                                                                    Text="{Binding Gender,
                                                                                        StringFormat=({0})}"/>

                                                                            </StackPanel>

                                                                        </Border>

                                                                    </DataTemplate>

                                                                </ItemsControl.ItemTemplate>

                                                            </ItemsControl>

                                                        </StackPanel>

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </TabItem>

            </TabControl>

        </Border>

        <!-- =====================================
             ACTIONS
        ====================================== -->

        <StackPanel
            Grid.Row="6"

            Margin="25"

            Orientation="Horizontal"

            HorizontalAlignment="Right">

            <Button
                Width="150"

                Height="48"

                Margin="0,0,15,0"

                Content="Close"/>

            <Button
                Width="220"

                Height="48"

                Background="#2563EB"

                Foreground="White"

                FontSize="15"

                FontWeight="SemiBold"

                Content="Save PDF Reports"/>

        </StackPanel>

    </Grid>

</Window>