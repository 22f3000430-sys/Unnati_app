<Window
    x:Class="SeatingApp.Presentation.Views.Rooms.RoomManagementView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d"

    Title="Room Management"

    Height="600"

    Width="1000"

    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="15"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- TOP BAR -->

        <StackPanel
            Orientation="Horizontal">

            <Button
                Width="140"
                Height="38"

                FontSize="14"

                Content="Add Room"

                Command="{Binding AddRoomCommand}"/>

            <Button
                Width="140"
                Height="38"

                Margin="10,0,0,0"

                FontSize="14"

                Content="Save All"

                Command="{Binding SaveCommand}"/>

        </StackPanel>

        <!-- ROOM GRID -->

        <DataGrid
            Grid.Row="2"

            Margin="0,5,0,0"

            ItemsSource="{Binding Rooms}"

            AutoGenerateColumns="False"

            CanUserAddRows="False"

            CanUserDeleteRows="False"

            SelectionUnit="Cell"

            SelectionMode="Extended"

            GridLinesVisibility="All"

            HeadersVisibility="Column"

            ColumnWidth="*"

            RowHeight="32"

            FontSize="14"

            PreviewKeyDown="DataGrid_PreviewKeyDown">

            <DataGrid.Columns>

                <!-- ROOM NUMBER -->

                <DataGridTextColumn
                    Header="Room No"

                    Binding="{Binding RoomNumber,
                    UpdateSourceTrigger=PropertyChanged}"/>

                <!-- FLOOR -->

                <DataGridTextColumn
                    Header="Floor"

                    Binding="{Binding Floor,
                    UpdateSourceTrigger=PropertyChanged}"/>

                <!-- ROWS -->

                <DataGridTextColumn
                    Header="Rows"

                    Binding="{Binding Rows,
                    UpdateSourceTrigger=PropertyChanged}"/>

                <!-- COLUMNS -->

                <DataGridTextColumn
                    Header="Columns"

                    Binding="{Binding Columns,
                    UpdateSourceTrigger=PropertyChanged}"/>

                <!-- CAPACITY -->

                <DataGridTemplateColumn
                    Header="Capacity">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock
                                VerticalAlignment="Center">

                                <Run Text="{Binding Rows}"/>

                                <Run Text=" × "/>

                                <Run Text="{Binding Columns}"/>

                                <Run Text=" = "/>

                                <Run Text="{Binding Capacity,
                                Mode=OneWay}"/>

                            </TextBlock>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <!-- SUMMARY PANEL -->

        <Border
            Grid.Row="3"

            Margin="0,10,0,0"

            Padding="12"

            BorderThickness="1"

            BorderBrush="#D0D0D0"

            Background="#F5F5F5">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="40"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- TOTAL ROOMS -->

                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"

                    VerticalAlignment="Center"

                    Text="Total Rooms:"/>

                <TextBlock
                    Grid.Column="2"

                    FontSize="15"

                    VerticalAlignment="Center"

                    Text="{Binding TotalRooms}"/>

                <!-- TOTAL CAPACITY -->

                <TextBlock
                    Grid.Column="4"

                    FontSize="15"

                    FontWeight="SemiBold"

                    VerticalAlignment="Center"

                    HorizontalAlignment="Left"

                    Text="{Binding TotalCapacity,
                    StringFormat=Total Capacity: {0}}"/>

            </Grid>

        </Border>

    </Grid>

</Window>